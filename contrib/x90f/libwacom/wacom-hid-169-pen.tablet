# Yoga Book YB1-X90F (Yoga Book 1, CHT): Wacom HID 169 Pen digitizer
# USB HID descriptor 056A:0169 over i2c-hid. Sensor is portrait
# 134x214mm, aligned with the panel's native portrait scanout.
# IntegratedIn=System makes mutter map it to the built-in panel and apply
# the panel-orientation + display-rotation transform (docs/05). Do NOT set
# Rotate= and do NOT add a udev LIBINPUT_CALIBRATION_MATRIX: either would
# add a second rotation outside GNOME's mapping.
[Device]
Name=Wacom HID 169 Pen
ModelName=WACF0169
Class=ISDV4
DeviceMatch=i2c|056a|0169;
IntegratedIn=Display;System

[Features]
Stylus=true
Reversible=false
Buttons=0
