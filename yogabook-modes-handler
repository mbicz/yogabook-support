#!/usr/bin/python3

import evdev, evdev.ecodes as ecodes
import array
import fcntl
import glob
import signal
import subprocess
import sys
import os
import threading
import time
import queue
import selectors
import pyudev
import logging

TS_DEV = "i2c-HDP0001:00"
TS_DRV_PATH = "/sys/bus/i2c/drivers/i2c_hid_acpi"

logging.basicConfig( encoding='utf-8', level=logging.DEBUG)

def disable_touchscreen():
    logging.info("Disable touchscreen")
    subprocess.run(f"echo {TS_DEV} > {TS_DRV_PATH}/unbind", shell=True, check=False)

def enable_touchscreen():
    logging.info("Enable touchscreen")
    subprocess.run(f"echo {TS_DEV} > {TS_DRV_PATH}/bind", shell=True, check=False)

def handle_input_event(event):
    logging.debug("event {}".format(event))

    if event.type == evdev.ecodes.EV_SW and event.code == evdev.ecodes.SW_TABLET_MODE:
        if event.value == 1:
            logging.info("Entering to tablet mode")
        else:
            logging.info("Exiting from tablet mode")

    if event.type == evdev.ecodes.EV_SW and event.code == evdev.ecodes.SW_LID:
        if event.value == 1:
            logging.info("Lid is closed, disabling touchscreen")
            disable_touchscreen()
        else:
            logging.info("Lid is opened, enabling touchscreen")
            enable_touchscreen()

# Posture. libinput, GNOME and KDE read SW_TABLET_MODE as "the keyboard is out
# of the way": desktops enable automatic screen rotation only in tablet mode.
# The kernel's tablet mode switch reports the back-side hall sensor, which
# closes only when the machine is folded flat. The screen should also rotate
# while the machine lies open flat (hinge ~178 degrees) and in stand or tent
# poses, so the switch published here is on when the machine is folded or the
# hinge is open past TABLET_ON_DEG, and off again once the hinge is back in
# laptop range. libinput ignores the kernel switch (61-yogabook-tablet-mode.rules):
# two tablet mode switches would override each other.
KERNEL_SWITCH = "Lenovo Yoga Book Tablet Mode Switch"
POSTURE_SWITCH = "Lenovo Yoga Book Posture Switch"
TABLET_ON_DEG = 165     # hinge at or above: tablet mode
TABLET_OFF_DEG = 155    # hinge LAPTOP_MIN_DEG..TABLET_OFF_DEG: laptop mode
LAPTOP_MIN_DEG = 30     # below: closed, or folded flat (reads up to ~24)
POSTURE_POLL_S = 0.5
POSTURE_SETTLE = 2      # agreeing hinge polls before a change

def eviocgsw(fd):
    bits = array.array('B', [0] * 8)
    fcntl.ioctl(fd, (2 << 30) | (len(bits) << 16) | (ord('E') << 8) | 0x1b, bits)
    return bits

def find_kernel_switch():
    for path in sorted(glob.glob("/dev/input/event*")):
        try:
            ed = evdev.InputDevice(path)
        except OSError:
            continue
        if ed.name == KERNEL_SWITCH:
            return ed
        ed.close()
    return None

def find_hinge():
    # The first angle channel of the "hinge" IIO sensor is the angle between
    # the halves; iio:deviceN numbers follow probe order.
    for label in sorted(glob.glob("/sys/bus/iio/devices/iio:device*/in_angl0_label")):
        try:
            with open(label) as f:
                if f.read().strip() == "hinge":
                    return os.path.join(os.path.dirname(label), "in_angl0_raw")
        except OSError:
            continue
    return None

def read_hinge(path):
    try:
        with open(path) as f:
            return int(f.read()) % 360
    except (OSError, ValueError):
        return None

def posture_loop(ui):
    kernel_sw = None
    hinge = find_hinge()
    if not hinge:
        logging.warning("No hinge angle sensor: tablet mode follows the hall sensor only")
    tablet = None
    votes = 0

    while True:
        if kernel_sw is None:
            kernel_sw = find_kernel_switch()
        folded = False
        if kernel_sw is not None:
            try:
                folded = bool(eviocgsw(kernel_sw.fd)[ecodes.SW_TABLET_MODE // 8] &
                              (1 << (ecodes.SW_TABLET_MODE % 8)))
            except OSError:
                kernel_sw.close()
                kernel_sw = None
        angle = read_hinge(hinge) if hinge else None

        if folded:
            want, votes = True, POSTURE_SETTLE
        elif not hinge:
            want, votes = False, POSTURE_SETTLE
        elif angle is not None and angle >= TABLET_ON_DEG:
            want = True
        elif angle is not None and LAPTOP_MIN_DEG <= angle <= TABLET_OFF_DEG:
            want = False
        else:
            # Unreadable, in the hysteresis band, closed, or a wrapped reading
            # while folding: keep the current pose.
            want = bool(tablet)

        if tablet is None or want != tablet:
            votes += 1
            if tablet is None or votes >= POSTURE_SETTLE:
                tablet = want
                ui.write(ecodes.EV_SW, ecodes.SW_TABLET_MODE, int(tablet))
                ui.syn()
                logging.info("Posture: {} (hinge {}, folded {})".format(
                    "tablet" if tablet else "laptop", angle, folded))
                votes = 0
        else:
            votes = 0
        time.sleep(POSTURE_POLL_S)

def run_posture(ui):
    while True:
        try:
            posture_loop(ui)
        except Exception as e:
            logging.error("Posture switch failed: {}".format(e))
            time.sleep(5)

def stop(signum, frame):
    # Leave tablet mode before the switch disappears: a switch removed while on
    # leaves desktops in tablet mode, and its successor starts off without an
    # event that would correct them.
    posture_ui.write(ecodes.EV_SW, ecodes.SW_TABLET_MODE, 0)
    posture_ui.syn()
    time.sleep(0.2)
    sys.exit(0)

monitored_devices = {}

context = pyudev.Context()

monitor = pyudev.Monitor.from_netlink(context)
monitor.filter_by('input')

device_events = queue.Queue()

def match_dev(device):
    if not device.sys_name.startswith("event"):
        return False

    try:
        ed = evdev.InputDevice(device.device_node)
        caps = ed.capabilities()

        if ecodes.EV_KEY in caps and ecodes.KEY_TOUCHPAD_OFF in caps[ecodes.EV_KEY] and ecodes.KEY_TOUCHPAD_ON in caps[ecodes.EV_KEY]:
            logging.info("Found evdev with touchpad ON/OFF capabilities: {}".format(device.device_node))
            return True

        if ecodes.EV_SW in caps and ecodes.SW_TABLET_MODE in caps[ecodes.EV_SW]:
            logging.info("Found evdev for tablet mode switch: {}".format(device.device_node))
            return True

        if ecodes.EV_SW in caps and ecodes.SW_LID in caps[ecodes.EV_SW]:
            logging.info("Found evdev for lid switch: {}".format(device.device_node))
            return True
    except:
        return False


def udev_event(action, device):
    logging.debug("udev: {} device: {}".format(action, device))

    if action == "add":
        if match_dev(device):
            device_events.put(('add', device))

    if action == "remove":
        device_events.put(('remove', device))


observer = pyudev.MonitorObserver(monitor, udev_event)
observer.start()

for device in context.list_devices(subsystem="input"):
    if match_dev(device):
        ed = evdev.InputDevice(device.device_node)
        monitored_devices[device.device_node] = ed

selector = selectors.DefaultSelector()
for node, ed in monitored_devices.items():
    selector.register(ed, selectors.EVENT_READ)

posture_ui = evdev.UInput({ecodes.EV_SW: [ecodes.SW_TABLET_MODE]}, name=POSTURE_SWITCH,
                          bustype=ecodes.BUS_HOST, phys="yogabook-modes-handler/input0")
signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)
threading.Thread(target=run_posture, args=(posture_ui,), daemon=True).start()


while True:
    select_events = selector.select(timeout=1)

    if len(select_events) == 0:
        while device_events.qsize() > 0:
            action, device = device_events.get()

            if action == "remove":
                if device.device_node in monitored_devices:
                    ed = monitored_devices[device.device_node]
                    selector.unregister(ed)
                    del monitored_devices[device.device_node]

            if action == "add":
                ed = evdev.InputDevice(device.device_node)
                monitored_devices[device.device_node] = ed
                selector.register(ed, selectors.EVENT_READ)

            device_events.task_done()

    for key, mask in select_events:
        device = key.fileobj

        try:
            event = device.read_one()
        except Exception as e:
            logging.info("Failed to read from {}".format(device))
            logging.info(e)
            selector.unregister(device)
            del monitored_devices[device.path]
            continue

        handle_input_event(event)

observer.stop()
